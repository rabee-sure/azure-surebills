{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.5",
        "ampeco/nova-date-range-filter": "^0.1.1",
        "anaseqal/nova-sidebar-icons": "^0.0.3",
        "beyondcode/laravel-websockets": "^1.4",
        "chris-ware/nova-breadcrumbs": "^2.0",
        "codebykyle/calculated-field": "^1.1",
        "digital-creative/nova-range-input-filter": "^0.1.5",
        "ebess/advanced-nova-media-library": "^3.3",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^6.3",
        "hashids/hashids": "^4.0",
        "jenssegers/date": "^4.0",
        "laravel-validation-rules/credit-card": "^1.3",
        "laravel/framework": "^7.0",
        "laravel/horizon": "^4.0.0",
        "laravel/nova": "*",
        "laravel/passport": "^9.2",
        "laravel/sanctum": "^2.8",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^2.0",
        "laravel/vapor-cli": "^1.7",
        "maatwebsite/excel": "^3.1",
        "maatwebsite/laravel-nova-excel": "^1.2",
        "multicaret/laravel-unifonic": "^1.0",
        "naif/toggle": "^1.2",
        "predis/predis": "^1.1",
        "proengsoft/laravel-jsvalidation": "^4.0",
        "pusher/pusher-php-server": "^4.0",
        "rcknr/nova-multiselect-filter": "^1.3",
        "spatie/laravel-medialibrary": "^8.0.0",
        "spatie/laravel-translatable": "^4.4",
        "spatie/laravel-webhook-server": "^1.11",
        "spatie/nova-translatable": "^3.0",
        "sure/home-analytics": "*",
        "sure/settlements": "*",
        "sure/userstats": "*",
        "timothyasp/nova-badge-field": "^1.0",
        "titasgailius/search-relations": "^1.0"
    },
    "require-dev": {
        "facade/ignition": "^2.0",
        "fzaninotto/faker": "^1.9.1",
        "laracasts/cypress": "^1.3",
        "laravel/telescope": "^3.5.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "phpunit/phpunit": "^8.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "./nova"
        },
        {
            "type": "path",
            "url": "./nova-components/Settlements"
        },
        {
            "type": "path",
            "url": "./nova-components/Userstats"
        },
        {
            "type": "path",
            "url": "./nova-components/HomeAnalytics"
        }
    ]
}
