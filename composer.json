{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.8",
        "hashids/hashids": "^4.0",
        "laravel-validation-rules/credit-card": "^1.12",
        "laravel/framework": "^12.0",
        "laravel/helpers": "^1.8",
        "laravel/horizon": "^5.48",
        "laravel/passport": "^13.0",
        "laravel/sanctum": "^4.2",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "laravel/vapor-cli": "^1.67",
        "laravel/vapor-core": "^2.43",
        "league/flysystem-aws-s3-v3": "^3.29",
        "maatwebsite/excel": "^3.1",
        "multicaret/laravel-unifonic": "^2.1",
        "phpseclib/phpseclib": "^3.0",
        "predis/predis": "^2.0",
        "proengsoft/laravel-jsvalidation": "^4.10",
        "pusher/pusher-php-server": "^7.2",
        "salla/zatca": "^3.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-permission": "^6.23",
        "spatie/laravel-translatable": "^6.12",
        "spatie/laravel-webhook-server": "^3.8",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^14.4"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laracasts/cypress": "^3.0",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Allam\\Zatca\\": "app/Services/Zatca_Integration/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
