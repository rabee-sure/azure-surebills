{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.3|^8.0",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "hashids/hashids": "^4.0",
        "jenssegers/date": "^4.0",
        "laravel-validation-rules/credit-card": "^1.3",
        "laravel/framework": "^8.0",
        "laravel/helpers": "^1.4",
        "laravel/horizon": "^5.0.0",
        "laravel/legacy-factories": "^1.1",
        "laravel/passport": "^10.0",
        "laravel/sanctum": "^2.8",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "league/flysystem-aws-s3-v3": "^1.0",
        "laravel/vapor-cli": "^1.12",
        "laravel/vapor-core": "^2.10",
        "maatwebsite/excel": "^3.1",
        "multicaret/laravel-unifonic": "^1.0",
        "predis/predis": "^1.1",
        "proengsoft/laravel-jsvalidation": "^4.0",
        "pusher/pusher-php-server": "^4.0",
        "salla/zatca": "^2.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-medialibrary": "^9.0.0",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-translatable": "^4.6",
        "spatie/laravel-webhook-server": "^1.11",
        "vladimir-yuldashev/laravel-queue-rabbitmq": "^11.3"
    },
    "require-dev": {
        "facade/ignition": "^2.3.6",
        "fakerphp/faker": "^1.13",
        "laracasts/cypress": "^1.3",
        "laravel/telescope": "^4.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Allam\\Zatca\\": "app/Services/Zatca_Integration/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
